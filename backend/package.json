{
  "name": "learnsphere-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/database/migrator.js",
    "seed": "node src/database/seed.js",
    "seed:admin": "node src/database/seed-admin.js",
    "db:integrity": "node -e \"import('./src/database/index.js').then(m => m.runIntegrityCheck())\"",
    "db:backup": "node -e \"import('./src/database/index.js').then(m => m.createBackup())\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'Backend linting passed'"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "vitest": "^5.0.4"
  }
}
